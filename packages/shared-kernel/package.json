{
  "name": "@dc-inventory/shared-kernel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tiny shared kernel: Money, Sku, and branded IDs. No frameworks.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  }
}
