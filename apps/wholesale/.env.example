# Call the API directly from the browser (fastest local dev — skips the Next rewrite hop).
# NEXT_PUBLIC_API_URL=http://localhost:3001
#
# Leave empty to call `/wholesale/*` on this origin (rewritten to apps/api).
NEXT_PUBLIC_API_URL=

# Staff dashboard origin for staff-acting links from the wholesale shop.
NEXT_PUBLIC_INTERNAL_APP_URL=http://localhost:3000

# Fastify origin used by next.config.ts rewrites.
# Local: http://localhost:3001
# Vercel (Production + Preview): https://dc-inventory-api.fly.dev
API_PROXY_ORIGIN=http://localhost:3001
