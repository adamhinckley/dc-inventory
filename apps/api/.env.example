# PostgreSQL 18 — required to boot `pnpm dev:api`.
# Matches root Compose placeholders (`docker-compose.yml` / `.env.example`).
# Unit tests inject InMemoryDatabase and do not read this file.
#
# Swap with one word: DATABASE_TARGET=local or DATABASE_TARGET=neon.
# Unset target keeps the historic DATABASE_URL contract (CI / Compose).
# Neon must be the direct (unpooled) host — drizzle migrate cannot use -pooler.
# Pull secrets with `npx neon@latest env pull` or Neon MCP get_connection_string.
# Never commit a real Neon URL (OP8).
# `pnpm db:sync:local-from-neon` dumps DATABASE_URL_NEON onto local Compose.
# Set NEON_SYNC_ALLOWED_HOST to the exact direct development-branch hostname (unpooled).
DATABASE_TARGET=local
DATABASE_URL_LOCAL=postgres://postgres:postgres@localhost:5432/dc_inventory
DATABASE_URL_NEON=
NEON_SYNC_ALLOWED_HOST=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dc_inventory
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
# Set to a positive integer for hop-count trust (recommended: 1 behind one edge proxy).
# Use true only when you intentionally trust the full X-Forwarded-For chain.
TRUST_PROXY=1

# Core flags on without a licensing.subscriptions row (local and Fly).
# Unset = on except NODE_ENV=test. Set 0 to evaluate Postgres entitlements.
# FEATURES_ALL_CORE_ON=0

# Phase 1 local login placeholders for `pnpm db:seed:phase1`. Not production secrets.
PHASE1_STAFF_PASSWORD=phase1-staff-placeholder
PHASE1_WHOLESALE_PASSWORD=phase1-wholesale-placeholder

# Phase 3 demo history generator (`pnpm seed:demo`). Local Postgres only.
# DEMO_SEED defaults to dc-inventory-demo-1 when unset.
# DEMO_SEED_PROFILE=reduced (default) is fast UI/dev data; full replays the stakeholder bench.
# DEMO_SEED_RESET must be exactly 1 (after trimming) to truncate demo-owned schemas.
DEMO_SEED=dc-inventory-demo-1
DEMO_SEED_PROFILE=reduced
DEMO_SEED_RESET=
