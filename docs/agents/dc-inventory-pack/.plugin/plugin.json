{
  "$schema": "https://open-plugin-spec.org/schema/v1/plugin.json",
  "id": "com.dcinventory.build-agents",
  "name": "DC Inventory Build Agents",
  "version": "0.1.0",
  "description": "Cost-tiered coding agents for building the dc-inventory modular monolith (Catalog/Customers cheap; Identity/Inventory/Accounting strong).",
  "author": "dc-inventory",
  "license": "UNLICENSED",
  "homepage": "https://github.com/adamhinckley/dc-inventory",
  "keywords": ["inventory", "wholesale", "coding-agents", "build-time"],
  "engines": {
    "buzz": ">=0.9.0"
  },
  "personas": [
    "agents/scaffold.persona.md",
    "agents/identity.persona.md",
    "agents/catalog.persona.md",
    "agents/customers.persona.md",
    "agents/shop-ui.persona.md",
    "agents/dashboard-ui.persona.md",
    "agents/purchasing-sales.persona.md",
    "agents/inventory.persona.md",
    "agents/accounting.persona.md",
    "agents/fixit.persona.md"
  ],
  "pack_instructions": "instructions.md",
  "defaults": {
    "model": "openai:gpt-5.6-luna",
    "temperature": 0.2,
    "triggers": {
      "mentions": true,
      "keywords": [],
      "all_messages": false
    },
    "thread_replies": true,
    "broadcast_replies": false
  }
}
